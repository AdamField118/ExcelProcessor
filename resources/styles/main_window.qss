/*
Main Window Stylesheet - main_window.qss
Styles for the main application window components
*/

QMainWindow {
    background-color: rgb(0, 0, 0);
    color: rgb(240, 240, 240);
}

/* Title Label */
QLabel#titleLabel {
    color: rgb(0, 102, 204);
    font-size: 18pt;
    font-weight: bold;
    padding: 15px;
    background-color: transparent;
    border: none;
}

/* Group Boxes */
QGroupBox {
    font-weight: bold;
    border: 2px solid rgb(58, 58, 58);
    border-radius: 8px;
    margin-top: 1ex;
    padding-top: 15px;
    color: rgb(255, 153, 0);
    background-color: rgb(10, 10, 10);
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 8px 0 8px;
    color: rgb(255, 153, 0);
    font-weight: bold;
    background-color: rgb(0, 0, 0);
}

QGroupBox#inputFilesGroup {
    border-color: rgb(80, 80, 80);
}

QGroupBox#configurationGroup {
    border-color: rgb(80, 80, 80);
}

QGroupBox#outputGroup {
    border-color: rgb(80, 80, 80);
}

/* Input Fields */
QLineEdit {
    border-width: 2px;
    border-radius: 6px;
    border-color: rgb(58, 58, 58);
    border-style: inset;
    padding: 8px 12px;
    color: rgb(255, 255, 255);
    background: rgb(40, 40, 40);
    selection-background-color: rgb(255, 153, 0);
    selection-color: rgb(0, 0, 0);
    font-size: 9pt;
    min-height: 20px;
}

QLineEdit:focus {
    border-color: rgb(255, 153, 0);
    border-width: 2px;
    background: rgb(50, 50, 50);
}

/* Field Labels */
QLabel[class="fieldLabel"] {
    color: rgb(200, 200, 200);
    font-weight: normal;
    padding: 4px;
}

/* Text Areas */
QTextEdit {
    background-color: rgb(25, 25, 25);
    color: rgb(200, 200, 200);
    selection-background-color: rgb(255, 153, 0);
    selection-color: rgb(0, 0, 0);
    border: 2px solid rgb(58, 58, 58);
    border-radius: 6px;
    padding: 8px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 8pt;
}

QTextEdit:focus {
    border-color: rgb(255, 153, 0);
}

/* Progress Bar */
QProgressBar {
    text-align: center;
    color: rgb(255, 255, 255);
    border-width: 2px;
    border-radius: 8px;
    border-color: rgb(58, 58, 58);
    border-style: inset;
    background-color: rgb(25, 25, 25);
    font-weight: bold;
    min-height: 20px;
}

QProgressBar::chunk {
    background-color: qlineargradient(spread:pad, x1:0.5, y1:0.7, x2:0.5, y2:0.3, stop:0 rgba(255, 153, 0, 255), stop:1 rgba(255, 183, 30, 255));
    border-radius: 6px;
    margin: 2px;
}

/* Status Bar */
QStatusBar {
    background-color: rgb(15, 15, 15);
    color: rgb(200, 200, 200);
    border-top: 1px solid rgb(58, 58, 58);
    padding: 4px;
    font-size: 8pt;
}

QStatusBar::item {
    border: none;
}

/* Output Path Label */
QLabel#outputPathLabel {
    color: rgb(180, 180, 180);
    background-color: rgb(30, 30, 30);
    border: 1px solid rgb(58, 58, 58);
    border-radius: 4px;
    padding: 6px 10px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 8pt;
}

/* Buttons - Base Styling */
QPushButton {
    border-style: outset;
    border-width: 2px;
    border-top-color: qlineargradient(spread:pad, x1:0.5, y1:0.6, x2:0.5, y2:0.4, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
    border-right-color: qlineargradient(spread:pad, x1:0.4, y1:0.5, x2:0.6, y2:0.5, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
    border-left-color: qlineargradient(spread:pad, x1:0.6, y1:0.5, x2:0.4, y2:0.5, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
    border-bottom-color: rgb(58, 58, 58);
    border-bottom-width: 1px;
    border-style: solid;
    color: rgb(255, 255, 255);
    padding: 8px 16px;
    background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(77, 77, 77, 255), stop:1 rgba(97, 97, 97, 255));
    border-radius: 6px;
    font-weight: bold;
    min-width: 80px;
}

QPushButton:hover {
    border-style: outset;
    border-width: 2px;
    border-top-color: qlineargradient(spread:pad, x1:0.5, y1:0.6, x2:0.5, y2:0.4, stop:0 rgba(180, 180, 180, 255), stop:1 rgba(110, 110, 110, 255));
    border-right-color: qlineargradient(spread:pad, x1:0.4, y1:0.5, x2:0.6, y2:0.5, stop:0 rgba(180, 180, 180, 255), stop:1 rgba(110, 110, 110, 255));
    border-left-color: qlineargradient(spread:pad, x1:0.6, y1:0.5, x2:0.4, y2:0.5, stop:0 rgba(180, 180, 180, 255), stop:1 rgba(110, 110, 110, 255));
    border-bottom-color: rgb(115, 115, 115);
    border-bottom-width: 1px;
    border-style: solid;
    color: rgb(255, 255, 255);
    padding: 8px 16px;
    background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(107, 107, 107, 255), stop:1 rgba(157, 157, 157, 255));
}

QPushButton:pressed {
    border-style: outset;
    border-width: 2px;
    border-top-color: qlineargradient(spread:pad, x1:0.5, y1:0.6, x2:0.5, y2:0.4, stop:0 rgba(62, 62, 62, 255), stop:1 rgba(22, 22, 22, 255));
    border-right-color: qlineargradient(spread:pad, x1:0.4, y1:0.5, x2:0.6, y2:0.5, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
    border-left-color: qlineargradient(spread:pad, x1:0.6, y1:0.5, x2:0.4, y2:0.5, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
    border-bottom-color: rgb(58, 58, 58);
    border-bottom-width: 1px;
    border-style: solid;
    color: rgb(255, 255, 255);
    padding: 8px 16px;
    background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(77, 77, 77, 255), stop:1 rgba(97, 97, 97, 255));
}

QPushButton:disabled {
    border-style: outset;
    border-width: 2px;
    border-top-color: qlineargradient(spread:pad, x1:0.5, y1:0.6, x2:0.5, y2:0.4, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
    border-right-color: qlineargradient(spread:pad, x1:0.4, y1:0.5, x2:0.6, y2:0.5, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
    border-left-color: qlineargradient(spread:pad, x1:0.6, y1:0.5, x2:0.4, y2:0.5, stop:0 rgba(115, 115, 115, 255), stop:1 rgba(62, 62, 62, 255));
    border-bottom-color: rgb(58, 58, 58);
    border-bottom-width: 1px;
    border-style: solid;
    color: rgb(120, 120, 120);
    padding: 8px 16px;
    background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(57, 57, 57, 255), stop:1 rgba(77, 77, 77, 255));
}

/* Save As Button */
QPushButton#saveAsButton {
    color: rgb(0, 102, 204);
    border-color: rgb(255, 153, 0);
}